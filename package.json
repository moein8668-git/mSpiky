{
  "name": "live-transcribe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.electron.json",
    "build:electron": "node scripts/build-electron.mjs",
    "dev:desktop": "concurrently -n web,desktop -c magenta,green \"vite\" \"npm run dev:electron\"",
    "dev:electron": "node scripts/build-electron.mjs && wait-on http://127.0.0.1:5173 && electron ."
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@google/genai": "^1.29.0",
    "@phosphor-icons/react": "^2.1.10",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.8",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "electron": "^44.0.0",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  }
}
